# Copy to .env for local runs. Never commit .env. On a hosting provider, set these as env values.

# Token with Contents read/write on PRIVATE_DATA_REPO only (fine-grained token recommended)
GITHUB_TOKEN=
# Private repo that holds the stored files
PRIVATE_DATA_REPO=web12-app/api-curl-private-data
# Folder inside the private repo
PRIVATE_DATA_PREFIX=files/
# Required for upload and delete. Leave unset to disable writes.
API_KEY=
# Optional
MAX_UPLOAD_BYTES=1000000
