# Example configuration for the platform. Copy to .env for local development only.
# Never commit a real .env. Hosting platforms set these as environment variables or secrets.
# Secret values are shown as placeholders below.

# Required
SECRET_KEY=replace-with-a-random-64-hex-string
API_KEY_HASH_SECRET=replace-with-a-different-random-64-hex-string
GITHUB_TOKEN=replace-with-a-fine-grained-token-for-the-private-data-repo
PRIVATE_DATA_REPO=owner/private-data-repo

# Optional
# Only needed when a separate website calls the API from the browser. Same-origin pages need nothing.
CORS_ALLOWED_ORIGINS=
# Use COOKIE_SECURE=0 only for local http development.
COOKIE_SECURE=1
COOKIE_SAMESITE=Lax
SESSION_HOURS=12
MAX_RECORD_BYTES=65536
MAX_FILE_BYTES=1000000
# Key for the legacy /api/files endpoints (X-API-Key header). Leave empty to disable it.
LEGACY_API_KEY=
