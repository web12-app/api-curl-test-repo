# Copy to .env for LOCAL development only. Never commit .env.
# On a hosting provider, set these as environment values in the dashboard.
# Placeholders only. Do not put real values here.

# --- Required (the app refuses to start without these) ---------------------
# Signs login sessions. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# Peppers API key hashes. Generate the same way. Changing it invalidates all API keys.
API_KEY_HASH_SECRET=
# Fine-grained token: Contents read/write on PRIVATE_DATA_REPO only.
GITHUB_TOKEN=
# Private data repository (owner/name). Must stay private.
PRIVATE_DATA_REPO=owner/your-private-data-repo

# --- Optional ---------------------------------------------------------------
# Folder for the legacy /api/files endpoints inside the private repo
PRIVATE_DATA_PREFIX=files/
# Comma-separated https origins allowed to call the API with credentials (your GitHub Pages site)
CORS_ALLOWED_ORIGINS=
# Session lifetime in hours
SESSION_HOURS=12
# Set to 0 only for local http development. Keep 1 in production.
COOKIE_SECURE=1
# Lax (same-site), Strict, or None (cross-site frontend; requires COOKIE_SECURE=1)
COOKIE_SAMESITE=Lax
# Limits (bytes). File limit is capped at 1,000,000 by the Contents API.
MAX_FILE_BYTES=1000000
MAX_RECORD_BYTES=65536
# Legacy key for scripts using the old /api/files endpoints. Leave empty to disable.
LEGACY_API_KEY=
PORT=5000
