# Copy to .env for local runs only. Never commit .env.
# Hosting: set these in the host's environment settings, not in the repo.

# Login and signup (all three required; without them login is disabled and the public pages still work)
GITHUB_TOKEN=
PRIVATE_DATA_REPO=owner/private-data-repo
SESSION_SECRET=

# Optional
# SESSION_HOURS=12
# COOKIE_SECURE=0        # only for plain http on localhost
# TRUST_PROXY=1          # only behind a proxy that overwrites X-Forwarded-For
# PORT=3000
