; border: 1px solid rgba(126,226,255,.4); background: rgba(126,226,255,.08); color: #7ee2ff; font-size: .85rem; }\n      h1 { font-size: clamp(1.9rem, 4.5vw, 3rem); line-height: 1.15; margin: .9rem 0 .8rem; letter-spacing: -.02em; background: linear-gradient(120deg, #f0f6fc, #9ecbff 55%, #7ee2ff); -webkit-background-clip: text; background-clip: text; color: transparent; }\n      .hero-copy > p { color: #9aa7b5; font-size: 1.05rem; line-height: 1.6; margin: 0 0 1.4rem; max-width: 34rem; }\n      .cta-row { display: flex; flex-wrap: wrap; gap: .8rem; align-items: center; }\n      .btn { display: inline-flex; align-items: center; gap: .5rem; padding: .7rem 1.4rem; border-radius: 10px; text-decoration: none; font-weight: 600; transition: transform .12s ease, box-shadow .12s ease, background .12s ease; }\n      .btn.primary { color: #08111f; background: linear-gradient(120deg, #67e8f9, #818cf8); box-shadow: 0 6px 24px rgba(99,102,241,.4); }\n      .btn.primary:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(99,102,241,.55); }\n      .btn.ghost { color: #e6edf3; border: 1px solid rgba(230,237,243,.3); }\n      .btn.ghost:hover { background: rgba(255,255,255,.08); }\n      .btn.small { padding: .4rem .9rem; font-size: .9rem; }\n      ul.ticks { list-style: none; display: flex; flex-wrap: wrap; gap: 1.1rem; padding: 0; margin: 1.3rem 0 0; color: #9aa7b5; font-size: .9rem; }\n      ul.ticks li { display: inline-flex; align-items: center; gap: .35rem; }\n      ul.ticks svg { color: #34d399; }\n      .scene { position: relative; min-height: 340px; display: flex; align-items: center; justify-content: center; perspective: 900px; }\n      .cube { width: 140px; height: 140px; position: relative; transform-style: preserve-3d; animation: spin 16s linear infinite; }\n      .face { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #bfeaff; background: linear-gradient(135deg, rgba(99,102,241,.4), rgba(34,211,238,.16)); border: 1px solid rgba(190,227,255,.35); border-radius: 14px; box-shadow: inset 0 0 34px rgba(99,102,241,.35); }\n      .f1 { transform: translateZ(70px); } .f2 { transform: rotateY(180deg) translateZ(70px); }\n      .f3 { transform: rotateY(90deg) translateZ(70px); } .f4 { transform: rotateY(-90deg) translateZ(70px); }\n      .f5 { transform: rotateX(90deg) translateZ(70px); } .f6 { transform: rotateX(-90deg) translateZ(70px); }\n      @keyframes spin { from { transform: rotateX(-18deg) rotateY(0deg); } to { transform: rotateX(-18deg) rotateY(360deg); } }\n      .chip { position: absolute; display: inline-flex; align-items: center; gap: .5rem; padding: .55rem .85rem; border-radius: 12px; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.22); backdrop-filter: blur(6px); font-size: .85rem; animation: float 6s ease-in-out infinite; }\n      .chip svg { color: #7ee2ff; }\n      .c1 { top: 10%; left: 6%; } .c2 { bottom: 14%; right: 4%; animation-delay: 1.6s; } .c3 { top: 56%; left: 0; animation-delay: 3.2s; }\n      @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }\n      .more { margin-top: 4rem; }\n      .more h2 { font-size: 1.7rem; margin: 0 0 .3rem; }\n      .more .sub { color: #9aa7b5; margin: 0 0 1.4rem; }\n      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1rem; }\n      .card { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.13); border-radius: 14px; padding: 1.15rem; transition: transform .15s ease, background .15s ease; }\n      .card:hover { transform: perspective(600px) rotateX(4deg) rotateY(-4deg) translateY(-2px); background: rgba(255,255,255,.09); }\n      .card svg { color: #7ee2ff; }\n      .card h3 { margin: .6rem 0 .35rem; font-size: 1.02rem; }\n      .card p { margin: 0; color: #9aa7b5; font-size: .9rem; line-height: 1.55; }\n      footer.wfoot { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; max-width: 72rem; margin: 0 auto; padding: 1.2rem 1.4rem 2rem; color: #77808c; font-size: .85rem; border-top: 1px solid rgba(255,255,255,.1); }\n      footer.wfoot a { color: #9aa7b5; }\n      @media (prefers-reduced-motion: reduce) { .glow, .cube, .chip { animation: none; } .btn, .card { transition: none; } }\n    </style>\n    <script src=\"/sw-register.js\" defer></script>\n  </head>\n  <body class=\"welcome\">\n    <div class=\"glow g1\" aria-hidden=\"true\"></div>\n    <div class=\"glow g2\" aria-hidden=\"true\"></div>\n    <header class=\"wtop\">\n      <a class=\"brand\" href=\"/\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 2 3 7v10l9 5 9-5V7l-9-5z\"/><path d=\"M3 7l9 5 9-5\"/><path d=\"M12 12v10\"/></svg><span>File Vault</span></a>\n      <nav class=\"wauth\">\n        <a href=\"/login\">Log in</a>\n        <a class=\"btn small primary\" href=\"/signup\">Get started</a>\n      </nav>\n    </header>\n    <main>\n      <section class=\"hero\">\n        <div class=\"hero-copy\">\n          <span class=\"pill\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z\"/></svg> Free &middot; Private &middot; Yours</span>\n          <h1>Store files in your own GitHub repositories</h1>\n          <p>Create an account, upload any kind of file up to 2&nbsp;GB, preview it right in the browser or in a new tab, and share it with one link. The server keeps no copies - your bytes live as release assets in a private GitHub repository only you can read.</p>\n          <div class=\"cta-row\">\n            <a class=\"btn primary\" href=\"/signup\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M13 2 4 14h6l-1 8 9-12h-6l1-8z\"/></svg> Get started</a>\n            <a class=\"btn ghost\" href=\"/login\">Log in</a>\n          </div>\n          <ul class=\"ticks\">\n            <li><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4 12 5 5 11-11\"/></svg> No install</li>\n            <li><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4 12 5 5 11-11\"/></svg> Any file type</li>\n            <li><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4 12 5 5 11-11\"/></svg> Works on mobile</li>\n          </ul>\n        </div>\n        <div class=\"scene\" aria-hidden=\"true\">\n          <div class=\"cube\">\n            <div class=\"face f1\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 2 3 7v10l9 5 9-5V7l-9-5z\"/><path d=\"M3 7l9 5 9-5\"/><path d=\"M12 12v10\"/></svg></div>\n            <div class=\"face f2\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 6a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6z\"/></svg></div>\n            <div class=\"face f3\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg></div>\n            <div class=\"face f4\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M10 14a5 5 0 0 0 7.1 0l2.4-2.4a5 5 0 0 0-7.1-7.1L11 5.9\"/><path d=\"M14 10a5 5 0 0 0-7.1 0l-2.4 2.4a5 5 0 0 0 7.1 7.1L13 18\"/></svg></div>\n            <div class=\"face f5\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 16V4\"/><path d=\"m6 10 6-6 6 6\"/><path d=\"M4 20h16\"/></svg></div>\n            <div class=\"face f6\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 2 4 5v6c0 5 3.4 8.6 8 11 4.6-2.4 8-6 8-11V5l-8-3z\"/></svg></div>\n          </div>\n          <div class=\"chip c1\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 6a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6z\"/></svg><span>Any file type</span></div>\n          <div class=\"chip c2\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M10 14a5 5 0 0 0 7.1 0l2.4-2.4a5 5 0 0 0-7.1-7.1L11 5.9\"/><path d=\"M14 10a5 5 0 0 0-7.1 0l-2.4 2.4a5 5 0 0 0 7.1 7.1L13 18\"/></svg><span>Share links</span></div>\n          <div class=\"chip c3\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg><span>Live previews</span></div>\n        </div>\n      </section>\n\n      <section class=\"more\" id=\"more-info\">\n        <h2>More info</h2>\n        <p class=\"sub\">Everything you get with a free account.</p>\n        <div class=\"grid\">\n          <article class=\"card\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 2 4 5v6c0 5 3.4 8.6 8 11 4.6-2.4 8-6 8-11V5l-8-3z\"/></svg><h3>Secure accounts</h3><p>Passwords are stored only as scrypt hashes, sessions are signed cookies, and every form is checked against cross-site posts.</p></article>\n          <article class=\"card\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 6a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6z\"/></svg><h3>Any file, up to 2 GB</h3><p>Documents, video, audio, archives - file types are verified by their content signature, not just by the file name.</p></article>\n          <article class=\"card\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg><h3>Instant previews</h3><p>Images, PDF, text, video, and audio open in a sandboxed viewer or a new browser tab. Unknown or active types download safely instead.</p></article>\n          <article class=\"card\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M10 14a5 5 0 0 0 7.1 0l2.4-2.4a5 5 0 0 0-7.1-7.1L11 5.9\"/><path d=\"M14 10a5 5 0 0 0-7.1 0l-2.4 2.4a5 5 0 0 0 7.1 7.1L13 18\"/></svg><h3>Share links</h3><p>Publish a file with one link and turn it off whenever you want. Re-enabling makes a fresh link, so old ones stop working.</p></article>\n          <article class=\"card\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 16V4\"/><path d=\"m6 10 6-6 6 6\"/><path d=\"M4 20h16\"/></svg><h3>Upload links</h3><p>Let someone without an account send you a file through a revocable link with its own file and size limits.</p></article>\n          <article class=\"card\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m12 2 9 5-9 5-9-5 9-5z\"/><path d=\"m3 12 9 5 9-5\"/><path d=\"m3 17 9 5 9-5\"/></svg><h3>Resume big uploads</h3><p>Large files are sent in verified pieces, so a dropped connection never restarts from zero. You can also import straight from any http, https, or data: link.</p></article>\n        </div>\n      </section>\n    </main>\n    <footer class=\"wfoot\">\n      <span><a href=\"/api/health\">Service status</a></span>\n      <span>Your data stays in your GitHub repositories - the server keeps nothing.</span>\n    </footer>\n  </body>\n</html>\n",
