{
  "name": "nodejs-app",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js web app: accounts, file storage in private GitHub repositories, previews, share and upload links.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "build:client": "esbuild client/main.jsx --bundle --minify --jsx=automatic --target=es2019 --define:process.env.NODE_ENV=\\\"production\\\" --outfile=public/assets/app.js"
  },
  "dependencies": {
    "busboy": "1.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
